NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
APP_MODE=demo

JWT_SECRET=replace_with_a_secure_secret
JWT_REFRESH_SECRET=replace_with_an_optional_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=creatorflow_refresh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=creatorflow
DB_USER=root
DB_PASSWORD=secret

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@creatorflow.local

UPLOAD_ROOT=uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

